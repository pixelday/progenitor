{
  // Must equal the Worker's name in the Cloudflare dashboard. It appears in the public
  // workers.dev hostname, so treat it as permanent.
  "name": "progenitor",
  "compatibility_date": "2026-11-25",
  // No "main": an assets-only Worker has no code. Its absence keeps the site static.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The platform hostname. On until a domain is attached (docs/setup/4-launch.md).
  "workers_dev": true,
  // Preview hostnames: <name>-<worker>.<subdomain>.workers.dev. A branch's preview needs
  // this on: with it off the preview builds and has no address. On, every uploaded version
  // gets a public address too.
  "preview_urls": true,
  // Pull-request previews are built with `wrangler preview`, which reads this block.
  "previews": {}
}
