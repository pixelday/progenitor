{
  "extends": "astro/tsconfigs/strict",
  // Only the project's own files. A broader pattern would also type-check any other folder
  // that happens to sit here, such as a local scratch folder or a copied example project.
  "include": [".astro/types.d.ts", "src", "*.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Import Panda's generated helpers as 'styled-system/css' from any depth.
    // Astro reads tsconfig paths, so this alias works at build time too.
    "paths": {
      "styled-system/*": ["./styled-system/*"]
    }
  }
}
