---
import { getCollection } from 'astro:content';
import { css } from 'styled-system/css';
import Base from '../layouts/Base.astro';
import RecordBrowser from '../components/RecordBrowser';
import { toSummary } from '../lib/records';

// Build time only: read the YAML-backed collection, sort it, and slim it for the island.
const records = (await getCollection('records'))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .map(toSummary);

const categories = [...new Set(records.map((record) => record.category))].sort();
---

<Base>
  <h1 class={css({ fontSize: '3xl', fontWeight: 'bold' })}>Records</h1>
  <!--
    client:load: the whole list is prerendered as HTML, then hydrated for filtering.
    Without JavaScript every record is still listed and every link still works.
  -->
  <RecordBrowser client:load records={records} categories={categories} />
</Base>
