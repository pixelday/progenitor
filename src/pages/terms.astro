---
import Prose from '../components/Prose.astro';
import Base from '../layouts/Base.astro';
import { pages } from '../lib/pages';
import { site } from '../site';

const page = pages.terms;
---

<Base title={page.title} description={page.description}>
  <Prose>
    <h1>{page.title}</h1>
    <p>Last updated <time datetime={site.legalUpdated}>{site.legalUpdated}</time>.</p>
    {/* verify-dist.mjs refuses to build a launched site while this attribute is present. */}
    <p data-starter-placeholder>Starter text. Review and replace it before launch.</p>

    <h2 id="informational-only">Informational only</h2>
    <p>The content on this site is provided for information, as is, with no warranty.</p>

    <h2 id="content-license">Content license</h2>
    <p>State who owns the content and how it may be reused.</p>

    <h2 id="credits">Credits</h2>
    <p>List the fonts, libraries, images and data the site uses, with their licenses.</p>
  </Prose>
</Base>
