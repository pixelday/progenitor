---
import '../styles/global.css';
import { css } from 'styled-system/css';
import JsonLd from '../components/JsonLd.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { absolute, legalPages, pages } from '../lib/pages';
import { site } from '../site';

interface Props {
  /** Page title. The site name is appended. Omit it on the home page. */
  title?: string;
  description?: string;
  /** Only the 404 page sets this: it is never indexed and never states an absolute URL. */
  noindex?: boolean;
  /** Structured data for this page. Rendered only when the page is indexable. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, noindex = false, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;

// The launch switch. An indexable page states its absolute URL (canonical, share card,
// structured data). Any other page says noindex and states none.
const indexable = site.launched && !noindex;
// Absolute URL built from config, never from the request.
const canonical = absolute(Astro.url.pathname);

// The commit this build came from. Workers Builds sets the variable at build time;
// a local build says "local". scripts/verify-live.sh reads it to prove which deploy is live.
const marker = process.env.WORKERS_CI_COMMIT_SHA ?? 'local';

const link = css({ textDecoration: 'underline', _hover: { textDecoration: 'none' } });
const focusRing = { outline: '2px solid', outlineColor: 'focusRing', outlineOffset: '2px' };
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta name="format-detection" content="telephone=no" />
    {/* The page follows the operating system's light or dark preference (panda.config.ts),
        unless the visitor picks one in the header. Saying so here lets the browser paint the
        right background before the CSS arrives. The theme script reads the two theme colors,
        so it comes after them. */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={site.themeColor.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={site.themeColor.dark} />
    <ThemeScript />

    {/* Icons. The files live in public/, and verify-dist checks their type and size.
        sizes="32x32" on the ICO makes browsers that can use the SVG prefer it. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {
      indexable && (
        <Fragment>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:locale" content={site.locale} />
          <meta property="og:title" content={title ?? site.name} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={absolute(site.shareImage.path)} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={site.shareImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
        </Fragment>
      )
    }
    {indexable && jsonLd && <JsonLd data={jsonLd} />}
    <meta name="site-marker" content={marker} />
  </head>
  <body class={css({ color: 'fg', bg: 'bg', lineHeight: '1.5' })}>
    {/* Base UI popups portal into this isolated stacking context (see panda.config.ts). */}
    <div class="root">
      <a
        href="#main"
        class={css({
          position: 'absolute',
          left: '2',
          top: '-20',
          px: '3',
          py: '2',
          bg: 'bg',
          borderWidth: '1px',
          borderColor: 'fg',
          _focusVisible: { top: '2' },
        })}
      >
        Skip to content
      </a>
      <header
        class={css({
          maxW: '5xl',
          mx: 'auto',
          px: '6',
          pt: '6',
          display: 'flex',
          flexWrap: 'wrap',
          gap: '4',
          alignItems: 'center',
          justifyContent: 'space-between',
        })}
      >
        <a href="/" class={css({ fontWeight: 'semibold' })}>{site.name}</a>
        {/* The light, dark or system choice (src/scripts/theme.js). Hidden until that script
            runs: without JavaScript the control could do nothing, and the page follows the
            system. Hidden in print, which is always light. */}
        <label hidden class={css({ display: 'flex', gap: '2', alignItems: 'center', fontSize: 'sm', _print: { display: 'none' } })}>
          Theme
          <select
            id="theme"
            class={css({
              px: '2',
              py: '1',
              bg: 'bg',
              color: 'fg',
              borderWidth: '1px',
              borderColor: 'border.control',
              rounded: 'md',
              cursor: 'pointer',
              _focusVisible: focusRing,
            })}
          >
            <option value="system">System</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
      </header>
      <main id="main" class={css({ maxW: '5xl', mx: 'auto', p: '6', display: 'grid', gap: '6' })}>
        <slot />
      </main>
      <footer class={css({ maxW: '5xl', mx: 'auto', px: '6', py: '8', fontSize: 'sm', color: 'fg.muted' })}>
        <nav aria-label="Footer">
          <ul class={css({ display: 'flex', flexWrap: 'wrap', columnGap: '4', rowGap: '2' })}>
            {
              [...legalPages, pages.sitemap].map((page) => (
                <li>
                  <a href={page.path} class={link}>
                    {page.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class={css({ mt: '3' })}>&copy; {new Date().getFullYear()} {site.name}</p>
      </footer>
    </div>
  </body>
</html>
