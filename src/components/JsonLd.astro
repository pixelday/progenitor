---
// Structured data. This is the one file allowed to use set:html, and verify-dist checks that.
// Astro does not evaluate {expressions} inside <script>, so the JSON has to go in as raw text.
// "<" is escaped, so no value can close the element.
import { createHash } from 'node:crypto';

interface Props {
  data: Record<string, unknown>;
}

const json = JSON.stringify(Astro.props.data).replace(/</g, '\\u003c');

// Browsers do not apply script-src to a data block, but the W3C checker does. The block's
// hash goes into this page's policy, so every inline <script> on the site is accounted for.
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(json).digest('base64')}`);
---

<script type="application/ld+json" is:inline set:html={json} />
